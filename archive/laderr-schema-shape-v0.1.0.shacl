@prefix : <https://w3id.org/pedropaulofb/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Shapes for Classes
#################################################################

### Shape for LaderrSpecification
:Shape_LaderrSpecification a sh:NodeShape ;
    sh:targetClass :LaderrSpecification ;
    sh:property [
        sh:path :composedOf ;
        sh:class :RiskEntity ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :createdBy ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :baseURI ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :createdOn ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :title ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :modifiedOn ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :version ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

### Shape for RiskEntity
:Shape_RiskEntity a sh:NodeShape ;
    sh:targetClass :RiskEntity ;
    sh:property [
        sh:path :id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .
