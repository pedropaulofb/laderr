@prefix : <https://w3id.org/pedropaulofb/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Shapes for Classes
#################################################################

### Shape for LaderrSpecification
:Shape_LaderrSpecification a sh:NodeShape ;
    sh:targetClass :LaderrSpecification ;

    # Represents the relationship between a LaderrSpecification and one or more RiskEntity instances.
    # Validation:
    # - At least one RiskEntity must be associated (minCount 1).
    # - Issues an informational message if no RiskEntity is found.
    sh:property [
        sh:path :composedOf ;
        sh:class :RiskEntity ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Empty LaDeRR declaration. No RiskEntity found."@en ;
    ] ;

    # Title property: Specifies the title of the LaderrSpecification.
    # Validation:
    # - Required with exactly one value (minCount 1, maxCount 1).
    # - Issues a warning if missing and an error if multiple values are found.
    sh:property [
        sh:path :title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'title' not found."@en ;
    ] ;
    sh:property [
        sh:path :title ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'title' found."@en ;
    ] ;

    # Description property: Provides an optional textual description of the LaderrSpecification.
    # Validation:
    # - Optional field (can have zero or one value).
    # - Issues an informational message if missing and an error if multiple values are found.
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Optional metadata 'description' not found."@en ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'description' found."@en ;
    ] ;

    # Version property: Specifies the version of the LaderrSpecification.
    # Validation:
    # - Required with exactly one value (minCount 1, maxCount 1).
    # - Issues a warning if missing and an error if multiple values are found.
    sh:property [
        sh:path :version ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'version' not found."@en ;
    ] ;
    sh:property [
        sh:path :version ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'version' found."@en ;
    ] ;

    # CreatedBy property: Specifies the author(s) of the LaderrSpecification.
    # Validation:
    # - Required field (minCount 1).
    # - Issues a warning if missing.
    sh:property [
        sh:path :createdBy ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'createdBy' not found. No author declared."@en ;
    ] ;

    # CreatedOn property: Specifies the creation date of the LaderrSpecification.
    # Validation:
    # - Required with exactly one value (minCount 1, maxCount 1).
    # - Issues a warning if missing and an error if multiple values are found.
    sh:property [
        sh:path :createdOn ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'createdOn' not found. No creation date declared."@en ;
    ] ;
    sh:property [
        sh:path :createdOn ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'createdOn' found."@en ;
    ] ;

    # ModifiedOn property: Provides an optional modified date for the LaderrSpecification.
    # Validation:
    # - Optional field (can have zero or one value).
    # - Issues an informational message if missing and an error if multiple values are found.
    sh:property [
        sh:path :modifiedOn ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Optional metadata 'modifiedOn' not found. No modified date declared."@en ;
    ] ;
    sh:property [
        sh:path :modifiedOn ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'modifiedOn' found."@en ;
    ] ;

    # BaseURI property: Specifies the base URI of the LaderrSpecification.
    # Validation:
    # - Required with exactly one value (minCount 1, maxCount 1).
    # - Issues a warning if missing and an error if multiple values are found.
    sh:property [
        sh:path :baseURI ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'baseURI' not found. The default value 'https://example.laderr#' will be adopted."@en ;
    ] ;
    sh:property [
        sh:path :baseURI ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'baseURI' found."@en ;
    ] .

### Shape for RiskEntity
:Shape_RiskEntity a sh:NodeShape ;
    sh:targetClass :RiskEntity ;
    
    # ID property: Represents the unique identifier of the RiskEntity instance.
    # Validation:
    # - Must have exactly one value (minCount 1, maxCount 1).
    # - Ideally globally unique (global uniqueness should be handled separately).
    sh:property [
        sh:path :id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # Name property: Specifies the name of the RiskEntity instance.
    # Validation:
    # - Required with exactly one value (minCount 1, maxCount 1).
    # - Issues a warning if missing and an error if multiple values are found.
    sh:property [
        sh:path :name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary 'name' not found in RiskEntity instance."@en ;
    ] ;
    sh:property [
        sh:path :name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for 'name' found in RiskEntity instance."@en ;
    ] ;

    # Description property: Provides an optional textual description of the RiskEntity instance.
    # Validation:
    # - Optional field (can have zero or one value).
    # - Issues an informational message if missing and an error if multiple values are found.
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Optional 'description' not found in RiskEntity instance."@en ;        
    ] ;    
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for 'description' found in RiskEntity instance."@en ;
    ] .
