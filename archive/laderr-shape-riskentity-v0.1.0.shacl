@prefix : <https://w3id.org/pedropaulofb/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Shape for RiskEntity
:Shape_RiskEntity a sh:NodeShape ;
    sh:targetClass :RiskEntity ;

    # ID property constraints
    sh:property [
        sh:path :id ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for 'id'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path :id ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Necessary 'id' not found in RiskEntity instance."@en ;
    ] ;
    sh:property [
        sh:path :id ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for 'id' found in RiskEntity instance."@en ;
    ] ;

    # Name property constraints
    sh:property [
        sh:path :name ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for 'name'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path :name ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary 'name' not found in RiskEntity instance."@en ;
    ] ;
    sh:property [
        sh:path :name ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for 'name' found in RiskEntity instance."@en ;
    ] ;

    # Description property constraints
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for 'description'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Optional 'description' not found in RiskEntity instance."@en ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for 'description' found in RiskEntity instance."@en ;
    ] .

