@prefix : <https://w3id.org/pedropaulofb/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix laderr: <https://w3id.org/pedropaulofb/laderr#> .

### Shape for Disposition
:Shape_Disposition a sh:NodeShape ;

    sh:targetClass :Disposition ;

    # State property constraints
    sh:property [
        sh:path laderr:state ;
        sh:in ( laderr:enabled laderr:disabled ) ;
        sh:severity sh:Violation ;
        sh:message "Invalid value for property 'state'. Expected one of laderr:enabled or laderr:disabled."@en ;
    ] ;
    sh:property [
        sh:path laderr:state ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Mandatory property 'state' is missing."@en ;
    ] .