@prefix laderr: <https://w3id.org/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

### Shape for LaderrConstruct
laderr:Shape_LaderrConstruct a sh:NodeShape ;

    sh:targetClass laderr:LaderrConstruct ;

    sh:closed true ;
    sh:ignoredProperties ( rdf:type owl:sameAs rdfs:label owl:topObjectProperty laderr:capabilities laderr:vulnerabilities laderr:state laderr:disables laderr:exploits laderr:exposes laderr:failedToDamage laderr:inhibits laderr:preserves laderr:preservesAgainst laderr:preservesDespite laderr:protects laderr:resiliences laderr:sustains laderr:threatens ) ;

    # description property constraints
    sh:property [
        sh:path laderr:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for 'description'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path laderr:description ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for 'description' found in LaderrConstruct instance."@en ;
    ] ;
    # sh:property [
    #     sh:path laderr:description ;
    #     sh:minCount 0 ;
    #     sh:severity sh:Info ;
    #     sh:message "Optional 'description' not found in LaderrConstruct instance."@en ;
    # ] ;

    # label property constraints
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for 'label'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Exactly one value for 'label' must be provided for LaderrConstruct."@en ;
    ] .
