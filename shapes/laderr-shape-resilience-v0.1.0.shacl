@prefix : <https://w3id.org/pedropaulofb/laderr#> .
@prefix laderr: <https://w3id.org/pedropaulofb/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

### Shape for Resilience
:Shape_Resilience a sh:NodeShape ;

    sh:targetClass :Resilience ;

    # Ensure each Resilience is related to exactly one Asset
    sh:property [
        sh:path [ sh:inversePath :resiliences ] ;
        sh:class :Asset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Each Resilience must be related to exactly one Asset."@en ;
    ] .