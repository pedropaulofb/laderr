@prefix : <https://w3id.org/pedropaulofb/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

### Shape for LaderrSpecification
:Shape_LaderrSpecification a sh:NodeShape ;

    sh:targetClass :LaderrSpecification ;

    # Specify that this shape is closed (no additional properties are allowed)
    sh:closed true ;
    
    # Specify the allowed properties
    sh:ignoredProperties ( rdf:type owl:sameAs ) ;

    # Represents the relationship between a LaderrSpecification and one or more RiskEntity instances
    sh:property [
        sh:path :composedOf ;
        sh:class :RiskEntity ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Empty LaDeRR declaration. No RiskEntity found."@en ;
    ] ;

    # Title property constraints
    sh:property [
        sh:path :title ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'title'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path :title ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'title' not found."@en ;
    ] ;
    sh:property [
        sh:path :title ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'title' found."@en ;
    ] ;

    # Description property constraints
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'description'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'description' found."@en ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Optional metadata 'description' not found."@en ;
    ] ;

    # Version property constraints
    sh:property [
        sh:path :version ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'version'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path :version ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'version' not found."@en ;
    ] ;
    sh:property [
        sh:path :version ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'version' found."@en ;
    ] ;

    # CreatedBy property constraints
    sh:property [
        sh:path :createdBy ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'createdBy'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path :createdBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'createdBy' not found. No author declared."@en ;
    ] ;

    # CreatedOn property constraints
    sh:property [
        sh:path :createdOn ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'createdOn'. Expected xsd:dateTime."@en ;
    ] ;
    sh:property [
        sh:path :createdOn ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'createdOn' not found. No creation date declared."@en ;
    ] ;
    sh:property [
        sh:path :createdOn ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'createdOn' found."@en ;
    ] ;

    # ModifiedOn property constraints
    sh:property [
        sh:path :modifiedOn ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'modifiedOn'. Expected xsd:dateTime."@en ;
    ] ;
    sh:property [
        sh:path :modifiedOn ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Optional metadata 'modifiedOn' not found. No modified date declared."@en ;
    ] ;
    sh:property [
        sh:path :modifiedOn ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'modifiedOn' found."@en ;
    ] ;

    # BaseURI property constraints
    sh:property [
        sh:path :baseUri ;
        sh:datatype xsd:anyURI ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'baseUri'. Expected xsd:anyURI."@en ;
    ] ;
    sh:property [
        sh:path :baseUri ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'baseUri' not found. The default value 'https://laderr.laderr#' will be adopted."@en ;
    ] ;
    sh:property [
        sh:path :baseUri ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'baseUri' found."@en ;
    ] .