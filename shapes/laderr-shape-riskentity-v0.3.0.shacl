@prefix : <https://w3id.org/pedropaulofb/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

### Shape for RiskEntity
:Shape_RiskEntity a sh:NodeShape ;

    sh:targetClass :RiskEntity ;

    # Specify that this shape is closed (no additional properties are allowed)
    sh:closed true ;

    # Specify the allowed properties
    sh:ignoredProperties ( rdf:type owl:sameAs rdfs:label ) ;

    # Ensure every instance is an instance of a valid subclass of RiskEntity
    sh:property [
        sh:path rdf:type ;
        sh:or (
            [ sh:hasValue :RiskEvent ]
            [ sh:hasValue :Object ]
            [ sh:hasValue :Disposition ]
            [ sh:hasValue :Vulnerability ]
            [ sh:hasValue :Capability ]
            [ sh:hasValue :Resilience ]
        ) ;
        sh:message "Instances of 'RiskEntity' must belong to one of its subclasses." ;
        sh:severity sh:Violation ;
    ] ;

    # NOT WORKING! TO BE SOLVED LATER. VERIFY DEBUG OPTIONS.
    # # Direct instantiation check
    # sh:not [
    #     sh:property [
    #         sh:path rdf:type ;
    #         sh:hasValue :RiskEntity ;
    #     ]
    # ] ;
    # sh:message "Instances of 'RiskEntity' should not be directly created. Use subclasses instead." ;
    # sh:severity sh:Info ;

    # Description property constraints
    sh:property [
        sh:path :description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for 'description'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for 'description' found in RiskEntity instance."@en ;
    ] ;
    sh:property [
        sh:path :description ;
        sh:minCount 0 ;
        sh:severity sh:Info ;
        sh:message "Optional 'description' not found in RiskEntity instance."@en ;
    ] .
