@prefix laderr: <https://w3id.org/laderr#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

### Shape for LaderrSpecification
laderr:Shape_LaderrSpecification a sh:NodeShape ;

    sh:targetClass laderr:LaderrSpecification ;

    # Specify that this shape is closed (no additional properties are allowed)
    sh:closed true ;
    
    # Specify the allowed properties
    sh:ignoredProperties ( rdf:type owl:sameAs rdfs:label ) ;

    # Represents the relationship between a LaderrSpecification and one or more LaderrConstruct instances
    sh:property [
        sh:path laderr:constructs ;
        sh:class laderr:LaderrConstruct ;
        sh:minCount 1 ;
        sh:severity sh:Info ;
        sh:message "Empty LaDeRR declaration. No LaderrConstruct found."@en ;
    ] ;

    # Title property constraints
    sh:property [
        sh:path laderr:title ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'title'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path laderr:title ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'title' not found."@en ;
    ] ;
    sh:property [
        sh:path laderr:title ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'title' found."@en ;
    ] ;

    # Description property constraints
    sh:property [
        sh:path laderr:description ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'description'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path laderr:description ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'description' found."@en ;
    ] ;
    # sh:property [
    #     sh:path laderr:description ;
    #     sh:minCount 1 ;
    #     sh:severity sh:Info ;
    #     sh:message "Optional metadata 'description' not found."@en ;
    # ] ;

    # Version property constraints
    sh:property [
        sh:path laderr:version ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'version'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path laderr:version ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'version' not found."@en ;
    ] ;
    sh:property [
        sh:path laderr:version ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'version' found."@en ;
    ] ;

    # CreatedBy property constraints
    sh:property [
        sh:path laderr:createdBy ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'createdBy'. Expected xsd:string."@en ;
    ] ;
    sh:property [
        sh:path laderr:createdBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'createdBy' not found. No author declared."@en ;
    ] ;

    # CreatedOn property constraints
    sh:property [
        sh:path laderr:createdOn ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'createdOn'. Expected xsd:dateTime."@en ;
    ] ;
    sh:property [
        sh:path laderr:createdOn ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Necessary metadata 'createdOn' not found. No creation date declared."@en ;
    ] ;
    sh:property [
        sh:path laderr:createdOn ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'createdOn' found."@en ;
    ] ;

    # ModifiedOn property constraints
    sh:property [
        sh:path laderr:modifiedOn ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'modifiedOn'. Expected xsd:dateTime."@en ;
    ] ;
    # sh:property [
    #     sh:path laderr:modifiedOn ;
    #     sh:minCount 1 ;
    #     sh:severity sh:Info ;
    #     sh:message "Optional metadata 'modifiedOn' not found. No modified date declared."@en ;
    # ] ;
    sh:property [
        sh:path laderr:modifiedOn ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'modifiedOn' found."@en ;
    ] ;

    # baseURI property constraints
    sh:property [
        sh:path laderr:baseURI ;
        sh:datatype xsd:anyURI ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'baseURI'. Expected xsd:anyURI."@en ;
    ] ;
    # sh:property [
    #     sh:path laderr:baseURI ;
    #     sh:minCount 1 ;
    #     sh:severity sh:Warning ;
    #     sh:message "Necessary metadata 'baseURI' not found. The default value 'https://laderr.laderr#' will be adopted."@en ;
    # ] ;
    sh:property [
        sh:path laderr:baseURI ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Multiple values for metadata 'baseURI' found."@en ;
    ] ;

    # Scenario property constraints
    sh:property [
        sh:path laderr:scenario ;
        sh:class laderr:ScenarioType ;
        sh:severity sh:Violation ;
        sh:message "Invalid datatype for metadata 'scenario'. Expected a value of type laderr:ScenarioType."@en ;
    ] ;
    sh:property [
        sh:path laderr:scenario ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Invalid number of values for metadata 'scenario'. Expected exactly one value."@en ;
    ] ;
    # sh:property [
    #     sh:path laderr:scenario ;
    #     sh:minCount 1 ;
    #     sh:severity sh:Warning ;
    #     sh:message "Necessary metadata 'scenario' not found. The default value 'operational' will be adopted."@en ;
    # ] ;
    sh:property [
        sh:path laderr:scenario ;
        sh:in ( laderr:operational laderr:incident laderr:resilient laderr:not_resilient ) ;
        sh:severity sh:Violation ;
        sh:message "The scenario must be one of: 'laderr:operational', 'laderr:incident', laderr:resilient, laderr:not_resilient."@en ;
    ] .