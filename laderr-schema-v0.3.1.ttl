foaf:name rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/pedropaulofb/laderr#capabilities
laderr:capabilities rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf laderr:composedOf ;
                    rdfs:domain laderr:Object ;
                    rdfs:range laderr:Capability .


###  https://w3id.org/pedropaulofb/laderr#composedOf
laderr:composedOf rdf:type owl:ObjectProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty .


###  https://w3id.org/pedropaulofb/laderr#disables
laderr:disables rdf:type owl:ObjectProperty ;
                rdfs:domain laderr:Capability ;
                rdfs:range laderr:Disposition .


###  https://w3id.org/pedropaulofb/laderr#exploits
laderr:exploits rdf:type owl:ObjectProperty ;
                rdfs:domain laderr:Capability ;
                rdfs:range laderr:Vulnerability .


###  https://w3id.org/pedropaulofb/laderr#exposes
laderr:exposes rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain laderr:Vulnerability ;
               rdfs:range laderr:Capability .


###  https://w3id.org/pedropaulofb/laderr#resiliences
laderr:resiliences rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf laderr:composedOf ;
                   rdfs:domain laderr:Object ;
                   rdfs:range laderr:Resilience .


###  https://w3id.org/pedropaulofb/laderr#state
laderr:state rdf:type owl:ObjectProperty ;
             rdfs:domain laderr:Disposition ;
             rdfs:range laderr:DispositionState .


###  https://w3id.org/pedropaulofb/laderr#vulnerabilities
laderr:vulnerabilities rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf laderr:composedOf ;
                       rdfs:domain laderr:Object ;
                       rdfs:range laderr:Vulnerability .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/pedropaulofb/laderr#baseURI
laderr:baseURI rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:anyURI .


###  https://w3id.org/pedropaulofb/laderr#createdBy
laderr:createdBy rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string .


###  https://w3id.org/pedropaulofb/laderr#createdOn
laderr:createdOn rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:dateTime .


###  https://w3id.org/pedropaulofb/laderr#description
laderr:description rdf:type owl:DatatypeProperty ;
                   rdfs:range xsd:string .


###  https://w3id.org/pedropaulofb/laderr#id
laderr:id rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:range xsd:string .


###  https://w3id.org/pedropaulofb/laderr#modifiedOn
laderr:modifiedOn rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:dateTime .


###  https://w3id.org/pedropaulofb/laderr#name
laderr:name rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:range xsd:string .


###  https://w3id.org/pedropaulofb/laderr#title
laderr:title rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:string .


###  https://w3id.org/pedropaulofb/laderr#version
laderr:version rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class .


###  https://w3id.org/pedropaulofb/laderr#Capability
laderr:Capability rdf:type owl:Class ;
                  rdfs:subClassOf laderr:Disposition ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty laderr:disables ;
                                    owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onClass laderr:Disposition
                                  ] .


###  https://w3id.org/pedropaulofb/laderr#Disposition
laderr:Disposition rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:unionOf ( laderr:Capability
                                                       laderr:Vulnerability
                                                     )
                                       ] ;
                   rdfs:subClassOf laderr:RiskEntity .


###  https://w3id.org/pedropaulofb/laderr#DispositionState
laderr:DispositionState rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( laderr:disabled
                                                          laderr:enabled
                                                        )
                                            ] .


###  https://w3id.org/pedropaulofb/laderr#LaderrSpecification
laderr:LaderrSpecification rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty laderr:composedOf ;
                                             owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                             owl:onClass laderr:RiskEntity
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty laderr:createdBy ;
                                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty laderr:baseURI ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:anyURI
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty laderr:createdOn ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty laderr:title ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty laderr:description ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty laderr:modifiedOn ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty laderr:version ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] .


###  https://w3id.org/pedropaulofb/laderr#Object
laderr:Object rdf:type owl:Class ;
              rdfs:subClassOf laderr:RiskEntity ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty laderr:capabilities ;
                                owl:someValuesFrom laderr:Capability
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty laderr:resiliences ;
                                owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                owl:onClass laderr:Resilience
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty laderr:vulnerabilities ;
                                owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                owl:onClass laderr:Vulnerability
                              ] .


###  https://w3id.org/pedropaulofb/laderr#Resilience
laderr:Resilience rdf:type owl:Class ;
                  rdfs:subClassOf laderr:RiskEntity .


###  https://w3id.org/pedropaulofb/laderr#RiskEntity
laderr:RiskEntity rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:unionOf ( laderr:Disposition
                                                      laderr:Object
                                                      laderr:Resilience
                                                      laderr:RiskEvent
                                                    )
                                      ] ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty laderr:id ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty laderr:name ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty laderr:description ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] .


###  https://w3id.org/pedropaulofb/laderr#RiskEvent
laderr:RiskEvent rdf:type owl:Class ;
                 rdfs:subClassOf laderr:RiskEntity .


###  https://w3id.org/pedropaulofb/laderr#Vulnerability
laderr:Vulnerability rdf:type owl:Class ;
                     rdfs:subClassOf laderr:Disposition ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty laderr:exposes ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass laderr:Capability
                                     ] .


