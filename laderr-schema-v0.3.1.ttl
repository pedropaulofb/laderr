<https://w3id.org/pedropaulofb/laderr> rdf:type owl:Ontology ;
                                        owl:versionIRI <https://w3id.org/ontouml/vocabulary/v0.1.0> ;
                                        dct:contributor <https://orcid.org/0000-0001-9247-6150> ,
