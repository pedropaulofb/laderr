#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( laderr:Disposition
                laderr:Entity
                laderr:Resilience
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( laderr:DispositionState
                laderr:LaderrConstruct
                laderr:LaderrSpecification
                laderr:ScenarioType
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( laderr:incident
                        laderr:not_resilient
                        laderr:operational
                        laderr:resilient
                      )
] .

