        <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Disposition"/>
        <rdfs:comment xml:lang="en">A disposition of an Entity that may be exploited by Threats, potentially leading to harm.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">Vulnerability</rdfs:label>
    </owl:Class>
    


