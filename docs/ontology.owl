                    <rdf:Description rdf:about="https://w3id.org/laderr#resilient"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">An enumeration defining different scenario types, including operational, incident, resilient, and not_resilient.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">ScenarioType</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/laderr#Threat -->


    <owl:Class rdf:about="https://w3id.org/laderr#Threat">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/laderr#threatens"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Asset"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Entity"/>
        <rdfs:comment xml:lang="en">A Threat is an entity that can potentially cause harm to an Asset through its threat capabilities, by potentially exploiting the latter&apos;s Vulnerabilities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">Threat</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/laderr#Vulnerability -->


    <owl:Class rdf:about="https://w3id.org/laderr#Vulnerability">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/laderr#exposes"/>
