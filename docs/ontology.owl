    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/laderr#capabilities -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#capabilities">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
        <rdfs:comment xml:lang="en">Associates an Entity with the Capabilities it possesses.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">capabilities</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#constructs -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#constructs">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#LaderrSpecification"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#LaderrConstruct"/>
        <rdfs:comment xml:lang="en">Links a LaDeRR Specification to its associated constructs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">constructs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#disables -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#disables">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Capability"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Disposition"/>
        <rdfs:comment xml:lang="en">Indicates that a Capability disables a specific Disposition, preventing it from being realized.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">disables</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#exploits -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#exploits">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Capability"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Vulnerability"/>
        <rdfs:comment xml:lang="en">Defines the relationship where a Capability exploits a Vulnerability, meaning that when both are enabled, the Capability can trigger an adverse event through the Vulnerability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">exploits</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#exposes -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#exposes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Vulnerability"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
        <rdfs:comment xml:lang="en">Defines that a Vulnerability exposes a Capability, making it susceptible to threats.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">exposes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#failedToDamage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#failedToDamage">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Threat"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Asset"/>
        <rdfs:comment xml:lang="en">Indicates that a Threat entity failed to damage an Asset because the Asset’s Vulnerability was disabled.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">failedToDamage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#inhibits -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#inhibits">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Control"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Threat"/>
        <rdfs:comment xml:lang="en">An Entity inhibits another if it has a Capability that disables a Vulnerability, while the inhibited Entity has a Capability that exploits the same Vulnerability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">inhibits</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#preserves -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#preserves">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Resilience"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
        <rdfs:comment xml:lang="en">A Resilience preserves a Capability by ensuring it remains functional (i.e., it preserves the value of this capability).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">preserves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#preservesAgainst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#preservesAgainst">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Resilience"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
        <rdfs:comment xml:lang="en">Indicates that a Resilience  preserves an entity despite the presence of a Capability in a Threat that would otherwise exploit a vulnerability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">preservesAgainst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#preservesDespite -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#preservesDespite">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Resilience"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Vulnerability"/>
        <rdfs:comment xml:lang="en">Indicates that a Resilience capability ensures the preservation of an Asset despite an existing Vulnerability on it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">preservesDespite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#protects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#protects">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Control"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Asset"/>
        <rdfs:comment xml:lang="en">Represents a relationship where an Entity prevents harm to another Entity by possessing a Capability that disables the relevant Vulnerability.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">protects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#resiliences -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#resiliences">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Asset"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Resilience"/>
        <rdfs:comment xml:lang="en">Links an Asset to its associated Resiliences.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">resiliences</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#scenario -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#scenario">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#LaderrSpecification"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#ScenarioType"/>
        <rdfs:comment xml:lang="en">Associates a LaDeRR Specification with a Scenario Type that describes its operational context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">scenario</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#state -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#state">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Disposition"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#DispositionState"/>
        <rdfs:comment xml:lang="en">Represents the current state of a Disposition, which can be either enabled or disabled.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#succeededToDamage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#succeededToDamage">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Threat"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Asset"/>
        <rdfs:comment xml:lang="en">Indicates that a Threat entity successfully damaged an Asset by exploiting an enabled vulnerability in the Asset.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">succeededToDamage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#sustains -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#sustains">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Capability"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Resilience"/>
        <rdfs:comment xml:lang="en">Represents the relationship between a Capability and a Resilience where the Capability enables the conditions necessary for the Resilience to exist.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">sustains</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#threatens -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#threatens">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Threat"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Asset"/>
        <rdfs:comment xml:lang="en">A Threat poses a potential risk to an Asset due to the presence of an exploitable Vulnerability in the latter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">threatens</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/laderr#vulnerabilities -->


    <owl:ObjectProperty rdf:about="https://w3id.org/laderr#vulnerabilities">
        <rdfs:domain rdf:resource="https://w3id.org/laderr#Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/laderr#Vulnerability"/>
        <rdfs:comment xml:lang="en">Associates an Entity with its Vulnerabilities, which may expose it to threats.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">vulnerabilities</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/laderr#baseURI -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/laderr#baseURI">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">Defines the base URI of a LaDeRR Specification.</rdfs:comment>
        <rdfs:label xml:lang="en">baseURI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/laderr#createdBy -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/laderr#createdBy">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Indicates the creator of a LaDeRR Specification.</rdfs:comment>
        <rdfs:label xml:lang="en">createdBy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/laderr#createdOn -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/laderr#createdOn">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Records the date and time when a LaDeRR Specification was created.</rdfs:comment>
        <rdfs:label xml:lang="en">createdOn</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/laderr#description -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/laderr#description">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A textual description providing details about a LaDeRR construct or specification.</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/laderr#modifiedOn -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/laderr#modifiedOn">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Records the date and time when a LaDeRR Specification was last modified.</rdfs:comment>
        <rdfs:label xml:lang="en">modifiedOn</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/laderr#name -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/laderr#name">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The name assigned to a LaDeRR Construct.</rdfs:comment>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/laderr#title -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/laderr#title">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The title assigned to a LaDeRR Specification.</rdfs:comment>
        <rdfs:label xml:lang="en">title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/laderr#version -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/laderr#version">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Specifies the version of a LaDeRR Specification.</rdfs:comment>
        <rdfs:label xml:lang="en">version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://xmlns.com/foaf/0.1/Organization -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
    


    <!-- https://w3id.org/laderr#Asset -->


    <owl:Class rdf:about="https://w3id.org/laderr#Asset">
        <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Entity"/>
        <rdfs:comment xml:lang="en">An Asset represents an entity that has value and is subject to potential risks and threats.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">Asset</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/laderr#Capability -->


    <owl:Class rdf:about="https://w3id.org/laderr#Capability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Disposition"/>
        <rdfs:comment xml:lang="en">A Capability is a disposition that enables an Entity to perform specific functions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">Capability</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/laderr#Control -->


    <owl:Class rdf:about="https://w3id.org/laderr#Control">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/laderr#inhibits"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Threat"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/laderr#protects"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Asset"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Control is an Entity that mitigates risks by inhibiting Threats and protecting Assets through its Capabilities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">Control</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/laderr#Disposition -->


    <owl:Class rdf:about="https://w3id.org/laderr#Disposition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/laderr#Capability"/>
                    <rdf:Description rdf:about="https://w3id.org/laderr#Vulnerability"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
