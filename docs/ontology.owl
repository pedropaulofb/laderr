    <!-- https://w3id.org/laderr#disabled -->


    <owl:NamedIndividual rdf:about="https://w3id.org/laderr#disabled">
        <rdf:type rdf:resource="https://w3id.org/laderr#DispositionState"/>
        <rdfs:comment xml:lang="en">Represents a DispositionState where a Capability or Vulnerability is inactive and cannot influence the system. A disabled Disposition cannot exert its effect until it is re-enabled.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">disabled</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/laderr#enabled -->


    <owl:NamedIndividual rdf:about="https://w3id.org/laderr#enabled">
        <rdf:type rdf:resource="https://w3id.org/laderr#DispositionState"/>
        <rdfs:comment xml:lang="en">Represents a DispositionState where a Capability or Vulnerability is active and can influence the system. An enabled Capability can, e.g., sustain a resilience, while an enabled Vulnerability can be exploited by threats.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">enabled</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/laderr#incident -->


    <owl:NamedIndividual rdf:about="https://w3id.org/laderr#incident">
        <rdf:type rdf:resource="https://w3id.org/laderr#ScenarioType"/>
        <rdfs:comment xml:lang="en">A scenario type in which a disruptive event has occurred, and its impact is being assessed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">incident</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/laderr#not_resilient -->


    <owl:NamedIndividual rdf:about="https://w3id.org/laderr#not_resilient">
        <rdf:type rdf:resource="https://w3id.org/laderr#ScenarioType"/>
        <rdfs:comment xml:lang="en">A scenario type where the system lacks resilience, meaning threats successfully exploit vulnerabilities, leading to damage or loss.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">not_resilient</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/laderr#operational -->


    <owl:NamedIndividual rdf:about="https://w3id.org/laderr#operational">
        <rdf:type rdf:resource="https://w3id.org/laderr#ScenarioType"/>
        <rdfs:comment xml:lang="en">A scenario type representing the system&apos;s current functioning, with or without threats and resiliences.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">operational</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/laderr#resilient -->


    <owl:NamedIndividual rdf:about="https://w3id.org/laderr#resilient">
        <rdf:type rdf:resource="https://w3id.org/laderr#ScenarioType"/>
        <rdfs:comment xml:lang="en">A scenario type where resiliences are sufficient to prevent threats from causing damage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">resilient</rdfs:label>
    </owl:NamedIndividual>
    


