            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An Entity is a fundamental concept that encompasses assets, threats, and controls in the resilience domain.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">Entity</rdfs:label>
    </owl:Class>
    


