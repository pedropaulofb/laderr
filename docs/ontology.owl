        <rdfs:comment xml:lang="en">Represents the state of a Disposition, which can be either ENABLED or DISABLED, determining whether it can be realized in a given scenario.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">DispositionState</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/laderr#Entity -->


    <owl:Class rdf:about="https://w3id.org/laderr#Entity">
        <owl:equivalentClass>
