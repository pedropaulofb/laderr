<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/laderr#"
     xml:base="https://w3id.org/laderr"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dcat="http://www.w3.org/ns/dcat#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/laderr">
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9247-6150"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-3452-553X"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-0481-9745"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0003-2736-7817"/>
        <terms:description xml:lang="en">Implementation of the abstract syntax of the LaDeRR (Language for Describing Risk and Resilience) DSL (Domain Specific Language) in OWL. Used to standardize the language&apos;s vocabulary and as schema for software use.</terms:description>
        <terms:identifier>https://w3id.org/laderr</terms:identifier>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-14</terms:issued>
        <terms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</terms:language>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-12</terms:modified>
        <terms:publisher rdf:resource="https://ugent-businessinformatics.github.io/"/>
        <terms:publisher rdf:resource="https://www.flandersmake.be/"/>
        <terms:publisher rdf:resource="https://www.utwente.nl/en/eemcs/scs/"/>
        <terms:title xml:lang="en">LaDeRR-Vocabulary</terms:title>
        <vann:preferredNamespacePrefix>laderr</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/laderr#</vann:preferredNamespaceUri>
        <owl:versionInfo xml:lang="en">First complete vocabulary for the LaDeRR DSL.</owl:versionInfo>
        <dcat:keyword xml:lang="en">DSL</dcat:keyword>
        <dcat:keyword xml:lang="en">incident</dcat:keyword>
        <dcat:keyword xml:lang="en">laderr</dcat:keyword>
        <dcat:keyword xml:lang="en">resilience</dcat:keyword>
        <dcat:keyword xml:lang="en">risk</dcat:keyword>
        <dcat:landingPage rdf:resource="https://w3id.org/laderr/git"/>
        <dcat:version>0.6.11</dcat:version>
        <foaf:homepage rdf:resource="https://w3id.org/laderr"/>
        <foaf:logo rdf:resource="https://raw.githubusercontent.com/pedropaulofb/laderr/refs/heads/main/resources/logo_laderr.png"/>
    </owl:Ontology>
    


