    <!-- https://w3id.org/laderr#Resilience -->


    <owl:Class rdf:about="https://w3id.org/laderr#Resilience">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/laderr#preserves"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Capability"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/laderr#preservesAgainst"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Capability"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/laderr#preservesDespite"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Vulnerability"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#LaderrConstruct"/>
        <rdfs:comment xml:lang="en">Resilience is a capability that preserves an entity&apos;s value despite vulnerabilities, preventing threats from causing damage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">Resilience</rdfs:label>
    </owl:Class>
    


