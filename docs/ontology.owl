        <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#LaderrConstruct"/>
        <rdfs:comment xml:lang="en">A Disposition is a potential of an Entity to exhibit certain behaviors or effects under specific conditions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
        <rdfs:label xml:lang="en">Disposition</rdfs:label>
