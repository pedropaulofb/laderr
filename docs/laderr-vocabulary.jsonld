    ]
  },
  {
    "@id": "https://w3id.org/laderr#Asset",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Asset represents an entity that has value and is subject to potential risks and threats."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Asset"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/laderr#Entity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A museum's ancient manuscript collection is an Asset because it holds historical and cultural value that can be lost."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Corresponds to the concept of Object at Risk in ResiliOnt."
      }
    ]
  },
  {
    "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b58",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDifferent"
    ],
    "http://www.w3.org/2002/07/owl#distinctMembers": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/laderr#resilient"
          },
          {
            "@id": "https://w3id.org/laderr#vulnerable"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/laderr#incident",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/laderr#ScenarioSituation"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Represents a scenario that has already occurred."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "incident"
      }
    ]
  },
  {
    "@id": "http://xmlns.com/foaf/0.1/Organization",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ]
  },
  {
    "@id": "https://w3id.org/laderr#state",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Defines whether a Disposition (Capability or Vulnerability) is active (enabled) or inactive (disabled). The state determines its eligibility for, e.g., exploitation and disabling."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/laderr#Disposition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "state"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/laderr#DispositionState"
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/identifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/laderr#preserves",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Indicates that a Resilience maintains the functionality and value of a Capability within a Scenario."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/laderr#Resilience"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "preserves"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/laderr#Capability"
      }
    ]
  },
  {
    "@id": "https://w3id.org/laderr#sustains",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Represents the relationship between a Capability and a Resilience where the Capability enables the conditions necessary for the Resilience to exist."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/laderr#Capability"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sustains"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/laderr#Resilience"
      }
    ]
  },
  {
    "@id": "https://w3id.org/laderr#Control",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A Control is an Entity that protects Assets by inhibiting threats (e.g., through disabling vulnerabilities)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Control"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/laderr#Entity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A fire suppression system in a data center acts as a Control that inhibits fire-related threats and protects the servers."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Corresponds to the concept of Risk Inhibitor in ResiliOnt."
      }
    ]
  },
  {
    "@id": "https://www.utwente.nl/en/eemcs/scs/",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://xmlns.com/foaf/0.1/Organization"
    ],
    "http://xmlns.com/foaf/0.1/homepage": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://www.utwente.nl/en/eemcs/scs/"
      }
    ],
    "http://xmlns.com/foaf/0.1/member": [
      {
        "@id": "https://orcid.org/0000-0002-3452-553X"
      },
      {
        "@id": "https://orcid.org/0000-0003-2736-7817"
      }
    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Semantics, Cybersecurity & Services (SCS), University of Twente, the Netherlands"
      }
    ]
  },
  {
    "@id": "https://w3id.org/laderr#Entity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Entity is a core participant in a Scenario, encompassing Assets, Threats, and Controls. Entities typically possess Capabilities and may have Vulnerabilities. They can protect, threaten, or inhibit others, depending on how their internal Dispositions are enabled. These interactions are derived from the interplay between their capabilities and vulnerabilities."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/laderr#ScenarioComponent"
      },
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b16"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b12"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Corresponds to the concept of Value Object in ResiliOnt."
      }
    ]
  },
  {
    "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b12",
