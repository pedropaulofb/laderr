    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Indicates that a Resilience ensures a Capability remains functional despite an existing Vulnerability exposing it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
