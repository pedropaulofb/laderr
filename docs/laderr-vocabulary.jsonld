[
  {
    "@id": "http://www.w3.org/ns/dcat#version",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/laderr#disabled",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://w3id.org/laderr#DispositionState"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Represents a DispositionState where a Capability or Vulnerability is inactive and cannot influence the system. A disabled Disposition cannot exert its effect until it is re-enabled."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "disabled"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A system’s temperature alarm is 'disabled' during maintenance, preventing it from influencing calculations."
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/modified",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/laderr#capabilities",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Associates an Entity with the Capabilities it possesses."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/laderr#Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "capabilities"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/laderr#Capability"
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/license",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ]
  },
  {
    "@id": "https://w3id.org/laderr#negativeDamage",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Superclass for relationships that indicate a negative occurrence of damage. Encompasses relations where a Threat either cannot cause or did not cause damage to an Asset. I.e., depending on the scenario’s situation, it is realized as laderr:cannotDamage (operational) or laderr:notDamaged (incident)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/laderr#Threat"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "negativeDamage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/laderr#Asset"
      }
    ]
  },
  {
    "@id": "https://w3id.org/laderr#Threat",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A Threat is an entity that can potentially cause harm to an Asset through its threat capabilities, by potentially exploiting the latter's Vulnerabilities."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Threat"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/laderr#Entity"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b40"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A ransomware attack targeting hospital records is a Threat that endangers critical health information systems."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Corresponds to the concept of Threat Object in ResiliOnt."
      }
    ]
  },
  {
    "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b40",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/laderr#threatens"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/laderr#Asset"
      }
    ]
  },
  {
    "@id": "https://w3id.org/laderr/ttl",
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "TTL serialization of the LaDeRR-Vocabulary."
      }
    ]
  },
  {
    "@id": "https://w3id.org/laderr#preservesAgainst",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Indicates that a Resilience maintains a Capability’s function despite the presence of a Threat's Capability that could exploit a Vulnerability."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/laderr#Resilience"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "preservesAgainst"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/laderr#Capability"
      }
    ]
  },
  {
    "@id": "https://w3id.org/laderr#Specification",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A structured document that defines one or more resilience scenarios, including constructs such as assets, threats, controls, and their interactions in specific operational or incident situations."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/laderr"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Specification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b33"
      },
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b34"
      },
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b35"
      },
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b36"
      },
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b37"
      },
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b38"
      },
      {
        "@id": "_:n2547adcb7a364616ab6df8f6aa40ce15b39"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "The 'Savannah Animal Survival Resilience Model' specification defines a structured model with scenarios like 'Dry Season Survival' and 'Heatwave Response', including constructs such as threats, capabilities, vulnerabilities, and resiliences for ecological analysis."
      }
    ]
  },
