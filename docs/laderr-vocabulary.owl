  <rdf:Description rdf:about="https://w3id.org/laderr#Capability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Disposition"/>
    <rdfs:comment xml:lang="en">A Capability is a disposition that enables an Entity to perform specific functions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Capability</rdfs:label>
    <ns6:example xml:lang="en">A drone's night-vision camera is a Capability enabling surveillance in low-light rescue operations.</ns6:example>
    <ns6:note xml:lang="en">Corresponds to the concept of Capability in ResiliOnt.</ns6:note>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/issued">
