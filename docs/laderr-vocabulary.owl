>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb36">
    <rdf:first rdf:resource="https://w3id.org/laderr#Disposition"/>
    <rdf:rest rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb37"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ugent-businessinformatics.github.io/">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <foaf:homepage rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ugent-businessinformatics.github.io/</foaf:homepage>
    <foaf:member rdf:resource="https://orcid.org/0000-0001-9247-6150"/>
    <foaf:member rdf:resource="https://orcid.org/0000-0003-0481-9745"/>
    <foaf:member rdf:resource="https://orcid.org/0000-0003-2736-7817"/>
    <foaf:name>UGent Business Informatics, Ghent University, Belgium</foaf:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#disabled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/laderr#DispositionState"/>
    <owl:differentFrom rdf:resource="https://w3id.org/laderr#enabled"/>
    <rdfs:comment xml:lang="en">Represents a DispositionState where a Capability or Vulnerability is inactive and cannot influence the system. A disabled Disposition cannot exert its effect until it is re-enabled.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">disabled</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#incident">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/laderr#ScenarioType"/>
    <rdfs:comment xml:lang="en">A scenario type in which a disruptive event has occurred, and its impact is being assessed.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">incident</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#disables">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Capability"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Disposition"/>
    <rdfs:comment xml:lang="en">Indicates that a Capability disables a specific Disposition, preventing it from being realized.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">disables</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#state">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Disposition"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#DispositionState"/>
    <rdfs:comment xml:lang="en">Represents the current state of a Disposition, which can be either enabled or disabled.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">state</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#name"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#baseURI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:comment xml:lang="en">Defines the base URI of a LaDeRR Specification.</rdfs:comment>
    <rdfs:label xml:lang="en">baseURI</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#not_resilient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/laderr#ScenarioType"/>
    <rdfs:comment xml:lang="en">A scenario type where the system lacks resilience, meaning threats successfully exploit vulnerabilities, leading to damage or loss.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">not_resilient</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb45">
    <rdf:first rdf:resource="https://w3id.org/laderr#incident"/>
    <rdf:rest rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb46"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#exposes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Vulnerability"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
    <rdfs:comment xml:lang="en">Defines that a Vulnerability exposes a Capability, making it susceptible to threats.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">exposes</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#resiliences">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Asset"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Resilience"/>
    <rdfs:comment xml:lang="en">Links an Asset to its associated Resiliences.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">resiliences</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0000-0001-9247-6150">
    <foaf:name>Geert Poels</foaf:name>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb41">
    <rdf:first rdf:resource="https://w3id.org/laderr#LaderrConstruct"/>
    <rdf:rest rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb42"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#title"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#Disposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb3"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb6"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#LaderrConstruct"/>
    <rdfs:comment xml:lang="en">A Disposition is a potential of an Entity to exhibit certain behaviors or effects under specific conditions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Disposition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#Entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb10"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#LaderrConstruct"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb14"/>
    <rdfs:comment xml:lang="en">An Entity is a fundamental concept that encompasses assets, threats, and controls in the resilience domain.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Specifies the version of a LaDeRR Specification.</rdfs:comment>
    <rdfs:label xml:lang="en">version</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb38">
    <rdf:first rdf:resource="https://w3id.org/laderr#Resilience"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb32">
    <rdf:first rdf:resource="https://w3id.org/laderr#resilient"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb31">
    <rdf:first rdf:resource="https://w3id.org/laderr#operational"/>
    <rdf:rest rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb32"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#baseURI"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb33">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#threatens"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Asset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#Resilience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb25"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb26"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb27"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#LaderrConstruct"/>
    <rdfs:comment xml:lang="en">Resilience is a capability that preserves an entity's value despite vulnerabilities, preventing threats from causing damage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Resilience</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#failedToDamage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Threat"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Asset"/>
    <rdfs:comment xml:lang="en">Indicates that a Threat entity failed to damage an Asset because the Asset’s Vulnerability was disabled.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">failedToDamage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#Control">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb1"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Entity"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb2"/>
    <rdfs:comment xml:lang="en">A Control is an Entity that mitigates risks by inhibiting Threats and protecting Assets through its Capabilities.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Control</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#capabilities">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Entity"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
    <rdfs:comment xml:lang="en">Associates an Entity with the Capabilities it possesses.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">capabilities</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#createdBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Indicates the creator of a LaDeRR Specification.</rdfs:comment>
    <rdfs:label xml:lang="en">createdBy</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#preservesAgainst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Resilience"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
    <rdfs:comment xml:lang="en">Indicates that a Resilience  preserves an entity despite the presence of a Capability in a Threat that would otherwise exploit a vulnerability.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">preservesAgainst</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#LaderrSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb17"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb18"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb19"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb20"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb21"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb22"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb23"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb24"/>
    <rdfs:comment xml:lang="en">A specification document that defines a structured resilience model, including assets, threats, and controls.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">LaderrSpecification</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#preserves">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Resilience"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
    <rdfs:comment xml:lang="en">A Resilience preserves a Capability by ensuring it remains functional (i.e., it preserves the value of this capability).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">preserves</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb11">
    <rdf:first rdf:resource="https://w3id.org/laderr#Asset"/>
    <rdf:rest rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb12"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb44">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDifferent"/>
    <owl:distinctMembers rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb45"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#enabled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/laderr#DispositionState"/>
    <rdfs:comment xml:lang="en">Represents a DispositionState where a Capability or Vulnerability is active and can influence the system. An enabled Capability can, e.g., sustain a resilience, while an enabled Vulnerability can be exploited by threats.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">enabled</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#ScenarioType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb28"/>
    <rdfs:comment xml:lang="en">An enumeration defining different scenario types, including operational, incident, resilient, and not_resilient.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">ScenarioType</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#resilient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/laderr#ScenarioType"/>
    <rdfs:comment xml:lang="en">A scenario type where resiliences are sufficient to prevent threats from causing damage.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">resilient</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb16">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#description"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#LaderrConstruct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb15"/>
    <rdfs:subClassOf rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb16"/>
    <rdfs:comment xml:lang="en">A base construct in the LaDeRR vocabulary, representing fundamental elements such as entities, their dispositions, and resilience concepts.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">LaderrConstruct</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcat:version>0.7.1</dcat:version>
    <dct:contributor rdf:resource="https://orcid.org/0000-0001-9247-6150"/>
    <dct:contributor rdf:resource="https://orcid.org/0000-0002-3452-553X"/>
    <dct:contributor rdf:resource="https://orcid.org/0000-0003-0481-9745"/>
    <dct:creator rdf:resource="https://orcid.org/0000-0003-2736-7817"/>
    <dct:description xml:lang="en">Implementation of the abstract syntax of the LaDeRR (Language for Describing Risk and Resilience) DSL (Domain Specific Language) in OWL. Used to standardize the language's vocabulary and as schema for software use.</dct:description>
    <dct:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/laderr</dct:identifier>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-01-14</dct:issued>
    <dct:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dct:language>
    <dct:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-13</dct:modified>
