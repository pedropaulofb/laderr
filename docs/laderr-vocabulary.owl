    <dct:title xml:lang="en">LaDeRR Vocabulary</dct:title>
    <vann:preferredNamespacePrefix>laderr</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/laderr#</vann:preferredNamespaceUri>
    <owl:versionInfo xml:lang="en">First complete vocabulary for the LaDeRR DSL.</owl:versionInfo>
    <dcat:keyword xml:lang="en">laderr</dcat:keyword>
    <dcat:keyword xml:lang="en">DSL</dcat:keyword>
    <dcat:keyword xml:lang="en">resilience</dcat:keyword>
    <dcat:keyword xml:lang="en">risk</dcat:keyword>
    <dcat:keyword xml:lang="en">incident</dcat:keyword>
    <dcat:landingPage rdf:resource="https://w3id.org/laderr/git"/>
    <foaf:homepage rdf:resource="https://w3id.org/laderr"/>
    <foaf:logo rdf:resource="https://raw.githubusercontent.com/pedropaulofb/laderr/refs/heads/main/resources/logo_laderr.png"/>
    <mod:repository rdf:resource="https://w3id.org/laderr/git"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#vulnerabilities">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Entity"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Vulnerability"/>
    <rdfs:comment xml:lang="en">Associates an Entity with its Vulnerabilities, which may expose it to threats.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">vulnerabilities</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#threatens">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Threat"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Asset"/>
    <rdfs:comment xml:lang="en">A Threat poses a potential risk to an Asset due to the presence of an exploitable Vulnerability in the latter.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">threatens</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#succeededToDamage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Threat"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Asset"/>
    <rdfs:comment xml:lang="en">Indicates that a Threat entity successfully damaged an Asset by exploiting an enabled vulnerability in the Asset.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">succeededToDamage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb47">
    <rdf:first rdf:resource="https://w3id.org/laderr#operational"/>
    <rdf:rest rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb48"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://orcid.org/0000-0003-0481-9745">
    <foaf:name>Frederik Gailly</foaf:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#scenario">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#LaderrSpecification"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#ScenarioType"/>
    <rdfs:comment xml:lang="en">Associates a LaDeRR Specification with a Scenario Type that describes its operational context.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">scenario</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#Vulnerability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb34"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Disposition"/>
    <rdfs:comment xml:lang="en">A disposition of an Entity that may be exploited by Threats, potentially leading to harm.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Vulnerability</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb14">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#capabilities"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Capability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#DispositionState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb7"/>
    <rdfs:comment xml:lang="en">Represents the state of a Disposition, which can be either ENABLED or DISABLED, determining whether it can be realized in a given scenario.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">DispositionState</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/member">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb12">
    <rdf:first rdf:resource="https://w3id.org/laderr#Control"/>
    <rdf:rest rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb13"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#operational">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/laderr#ScenarioType"/>
    <rdfs:comment xml:lang="en">A scenario type representing the system's current functioning, with or without threats and resiliences.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">operational</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb24">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#version"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The name assigned to a LaDeRR Construct.</rdfs:comment>
    <rdfs:label xml:lang="en">name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#preservesDespite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Resilience"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Vulnerability"/>
    <rdfs:comment xml:lang="en">Indicates that a Resilience capability ensures the preservation of an Asset despite an existing Vulnerability on it.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">preservesDespite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#preservesAgainst"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/laderr#Capability"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr/git">
    <rdfs:comment xml:lang="en">Repository for the LaDeRR DSL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#Asset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Entity"/>
    <rdfs:comment xml:lang="en">An Asset represents an entity that has value and is subject to potential risks and threats.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Asset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">A textual description providing details about a LaDeRR construct or specification.</rdfs:comment>
    <rdfs:label xml:lang="en">description</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.utwente.nl/en/eemcs/scs/">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <foaf:homepage rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.utwente.nl/en/eemcs/scs/</foaf:homepage>
    <foaf:member rdf:resource="https://orcid.org/0000-0002-3452-553X"/>
    <foaf:member rdf:resource="https://orcid.org/0000-0003-2736-7817"/>
    <foaf:name>Semantics, Cybersecurity &amp; Services (SCS), University of Twente, the Netherlands</foaf:name>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#inhibits">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Control"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Threat"/>
    <rdfs:comment xml:lang="en">An Entity inhibits another if it has a Capability that disables a Vulnerability, while the inhibited Entity has a Capability that exploits the same Vulnerability.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">inhibits</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#protects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Control"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Asset"/>
    <rdfs:comment xml:lang="en">Represents a relationship where an Entity prevents harm to another Entity by possessing a Capability that disables the relevant Vulnerability.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">protects</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#sustains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Capability"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Resilience"/>
    <rdfs:comment xml:lang="en">Represents the relationship between a Capability and a Resilience where the Capability enables the conditions necessary for the Resilience to exist.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">sustains</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb20">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#createdOn"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#Capability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Disposition"/>
    <rdfs:comment xml:lang="en">A Capability is a disposition that enables an Entity to perform specific functions.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Capability</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb18">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/laderr#createdBy"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#modifiedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">Records the date and time when a LaDeRR Specification was last modified.</rdfs:comment>
    <rdfs:label xml:lang="en">modifiedOn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#createdOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">Records the date and time when a LaDeRR Specification was created.</rdfs:comment>
    <rdfs:label xml:lang="en">createdOn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#Threat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1eeff2a894434e2a83b8d9ce03dc370cb33"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/laderr#Entity"/>
    <rdfs:comment xml:lang="en">A Threat is an entity that can potentially cause harm to an Asset through its threat capabilities, by potentially exploiting the latter's Vulnerabilities.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">Threat</rdfs:label>
  </rdf:Description>
