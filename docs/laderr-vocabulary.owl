  <rdf:Description rdf:about="https://w3id.org/laderr#disabled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/laderr#DispositionState"/>
    <rdfs:comment xml:lang="en">Represents a DispositionState where a Capability or Vulnerability is inactive and cannot influence the system. A disabled Disposition cannot exert its effect until it is re-enabled.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">disabled</rdfs:label>
    <ns6:example xml:lang="en">A system’s temperature alarm is 'disabled' during maintenance, preventing it from influencing calculations.</ns6:example>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/laderr#exposes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/laderr#Vulnerability"/>
    <rdfs:range rdf:resource="https://w3id.org/laderr#Capability"/>
    <rdfs:comment xml:lang="en">Defines that a Vulnerability exposes a Capability, making it susceptible to threats.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/laderr"/>
    <rdfs:label xml:lang="en">exposes</rdfs:label>
  </rdf:Description>
