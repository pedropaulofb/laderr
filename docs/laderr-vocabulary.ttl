@prefix : <https://w3id.org/laderr#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/laderr#> .

<https://w3id.org/laderr> rdf:type owl:Ontology ;
                           <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0001-9247-6150> ,
                                                                  <https://orcid.org/0000-0002-3452-553X> ,
                                                                  <https://orcid.org/0000-0003-0481-9745> ;
                           <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0003-2736-7817> ;
                           <http://purl.org/dc/terms/description> "Implementation of the abstract syntax of the LaDeRR (Language for Describing Risk and Resilience) DSL (Domain Specific Language) in OWL. Used to standardize the language's vocabulary and as schema for software use."@en ;
                           <http://purl.org/dc/terms/identifier> "https://w3id.org/laderr" ;
                           <http://purl.org/dc/terms/issued> "2025-01-14"^^xsd:date ;
                           <http://purl.org/dc/terms/language> "en"^^xsd:language ;
                           <http://purl.org/dc/terms/license> <https://www.apache.org/licenses/LICENSE-2.0> ;
                           <http://purl.org/dc/terms/modified> "2025-03-12"^^xsd:date ;
                           <http://purl.org/dc/terms/publisher> <https://ugent-businessinformatics.github.io/> ,
                                                                <https://www.flandersmake.be/> ,
                                                                <https://www.utwente.nl/en/eemcs/scs/> ;
                           <http://purl.org/dc/terms/title> "LaDeRR Vocabulary"@en ;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "laderr" ;
                           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/laderr#"^^xsd:anyURI ;
                           owl:versionInfo "First complete vocabulary for the LaDeRR DSL."@en ;
                           <http://www.w3.org/ns/dcat#keyword> "DSL"@en ,
                                                               "incident"@en ,
                                                               "laderr"@en ,
                                                               "resilience"@en ,
                                                               "risk"@en ;
                           <http://www.w3.org/ns/dcat#landingPage> <https://w3id.org/laderr/git> ;
                           <http://www.w3.org/ns/dcat#version> "0.6.11" ;
                           <http://xmlns.com/foaf/0.1/homepage> <https://w3id.org/laderr> ;
                           <http://xmlns.com/foaf/0.1/logo> <https://raw.githubusercontent.com/pedropaulofb/laderr/refs/heads/main/resources/logo_laderr.png> ;
                           <https://w3id.org/mod#repository> <https://w3id.org/laderr/git> .

