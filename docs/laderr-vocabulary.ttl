#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Disposition
                :Entity
                :Resilience
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :DispositionState
                :LaderrConstruct
                :LaderrSpecification
                :ScenarioType
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :disabled
                        :enabled
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :incident
                        :not_resilient
                        :operational
                        :resilient
                      )
] .


